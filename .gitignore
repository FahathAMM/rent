# ── Sensitive files — never commit ─────────────────────────────────────────
# Environment files (real config / secrets). The *.example templates stay tracked.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Keys, certificates, SSH and package-registry credentials
*.pem
*.key
*.crt
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*
auth.json
.npmrc

# Database dumps, local databases and backup archives
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.bak
*.zip
*.tgz
*.tar.gz

# Logs
*.log

# Browser profiles from automated/manual testing (cookies, saved logins, history)
.chrome-tmp/
**/.chrome-tmp/
chrome-profile*/

# Local tool settings
.claude/settings.local.json
postman/LankaLane-local.postman_environment.json
postman/LankaLane.postman_collection.json
