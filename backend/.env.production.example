APP_NAME=Enscone
APP_ENV=production
# Generate once with `php artisan key:generate --show` and set it as a fixed
# value here — never regenerate it on every deploy, or every existing
# session and any encrypted data becomes unreadable.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dubai
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=enscone
DB_USERNAME=enscone
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# The deployed Next.js app's origin — used for CORS and Sanctum's stateful
# domain check. Must match exactly (scheme + host, no trailing slash).
FRONTEND_URL=https://app.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com
