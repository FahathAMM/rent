# Always /api — the browser only ever calls same-origin /api/*, which this
# app's own server proxies to the real backend (see BACKEND_URL below and
# next.config.mjs). Baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=/api

# Server-side only — where the Laravel API actually runs. Read at request
# time by next.config.mjs's rewrites(), so it can be set at container
# runtime rather than baked in at build time.
BACKEND_URL=http://backend
